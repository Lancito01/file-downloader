{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Andy's Downloader",
    "version": "0.2.1",
    "identifier": "com.andy.file-downloader",
    "build": {
        "frontendDist": "../build",
        "devUrl": "http://localhost:5173",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "title": "Andy's Downloader",
                "width": 1000,
                "height": 720,
                "minWidth": 760,
                "minHeight": 560,
                "backgroundColor": "#0f1012",
                "resizable": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:;"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["msi"],
        "createUpdaterArtifacts": true,
        "icon": ["icons/pikachu.ico"],
        "resources": []
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwOTk4RjczQ0ZGQ0REODMKUldTRDNmelBjNCtaWUUweGNQMElYdCs5bkdrUVEyeTQzK01ndzFoK3VYeklTZnV6bDNrb2Y0RU0K",
            "endpoints": ["https://github.com/Lancito01/file-downloader/releases/latest/download/latest.json"],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
